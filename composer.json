{
  "name": "traewelling/traewelling",
  "type": "project",
  "description": "Free and open source check-in service to log your public transit journeys",
  "keywords": [
    "traewelling",
    "träwelling",
    "social",
    "network",
    "trains",
    "public transport"
  ],
  "license": "AGPL-3.0-only",
  "require": {
    "php": "^8.4",
    "ext-exif": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-simplexml": "*",
    "ext-sodium": "*",
    "barryvdh/laravel-dompdf": "^3.0",
    "darkaonline/l5-swagger": "^9.0",
    "easyrdf/easyrdf": "^1.1",
    "guzzlehttp/guzzle": "^7.1",
    "intervention/image": "^3.5",
    "jenssegers/agent": "^2.6",
    "laravel/framework": "^12.0",
    "laravel/passport": "^12.0",
    "laravel/socialite": "^5.0",
    "laravel/tinker": "^2.0",
    "laravel/ui": "^4.0",
    "predis/predis": "^3.0",
    "revolution/laravel-mastodon-api": "^3.0",
    "romanzipp/laravel-queue-monitor": "^5.0",
    "sibyx/phpgpx": "1.3.0",
    "spatie/icalendar-generator": "^3.0",
    "spatie/laravel-activitylog": "^4.7",
    "spatie/laravel-permission": "^7.0",
    "spatie/laravel-personal-data-export": "^4.3",
    "spatie/laravel-prometheus": "^1.0",
    "spatie/laravel-sitemap": "^8.0.0",
    "spatie/laravel-validation-rules": "^3.2",
    "spatie/laravel-webhook-server": "^3.4",
    "traewelling/google-polyline": "^0.3.0",
    "trwl/socialite-mastodon": "^1.2"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "barryvdh/laravel-debugbar": "^4.0",
    "barryvdh/laravel-ide-helper": "^3.5",
    "beyondcode/laravel-dump-server": "dev-master",
    "brianium/paratest": "^7.8",
    "fakerphp/faker": "^1.9",
    "filp/whoops": "^2.0",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.0",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^13.0",
    "roave/security-advisories": "dev-latest",
    "spatie/laravel-ignition": "2.11.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "stephank/composer-plugin-nixify": true
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "files": [
      "app/Helpers/Helper.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "post-install-cmd": [
      "scripts/generate-version.sh"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "dev:ssr": [
      "npm run build:ssr",
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ]
  }
}
