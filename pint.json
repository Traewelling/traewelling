{
  "preset": "laravel",
  "rules": {
    "concat_space": {
      "spacing": "one"
    },
    "method_chaining_indentation": true,
    "new_with_parentheses": true,
    "no_unused_imports": true,
    "not_operator_with_successor_space": false,
    "ordered_imports": {
      "sort_algorithm": "alpha"
    },
    "single_quote": true,
    "trailing_comma_in_multiline": true
  },
  "exclude": [
    "node_modules",
    "storage",
    "vendor"
  ]
}
