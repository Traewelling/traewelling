# Here you'll only need to change the APP_NAME if you want to
APP_NAME=Träwelling
MIX_APP_NAME=Träwelling
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FORCE_HTTPS=false

LOG_LEVEL=debug # You can change this to info, warning or error for production use

# Change this according to your database configuration
# To use SQLite, have a look here: https://laravel.com/docs/10.x/database#sqlite-configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

# These are the recommended default values
BROADCAST_DRIVER=log
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120

# To be able to send mails and debug them, you can set up a mailtrap.io account and enter your credentials here
# You can also take a look here for other configuration possibilities: https://laravel.com/docs/10.x/mail#configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# When set to FALSE, Träwelling will not attempt to post to social media, even if the users want to.
POST_SOCIAL=FALSE

# Minimum interval in minutes between real-time refreshes for a single trip
REFRESH_MIN_TRIP_INTERVAL_MINUTES=2

REGISTRATION_ENABLED=true

# Mastodon app credentials, only needed for logging in with and posting to mastodon
# https://docs.joinmastodon.org/methods/apps/
MASTODON_DOMAIN=
MASTODON_ID=
MASTODON_SECRET=
MASTODON_REDIRECT=
MASTODON_APPNAME=
MASTODON_SCOPES="read:statuses write:statuses read:accounts"

# Default values to be shown in the legal notice.
MIX_LEGAL_NAME="Max Mustermann"
MIX_LEGAL_ADDRESS1="Musterstraße 1"
MIX_LEGAL_ADDRESS2="12345 Musterstadt"
MIX_LEGAL_EMAIL="max@mustermann.de"
MIX_LEGAL_TEL="01234 / 56789"

# Should the year in review be visible to the users?
YEAR_IN_REVIEW_BACKEND=false
YEAR_IN_REVIEW_ALERT=false
YEAR_IN_REVIEW_SCHEDULER=false # Should the scheduler calculate the year in review for all users daily? If deactivated, it will be calculated upon request.

# Admin notifications: Telegram (active per type when token + the respective chat ID are set)
TELEGRAM_ADMIN_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ1234567890
TELEGRAM_ADMIN_EVENTS_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_REPORTS_CHAT_ID=-1001234567890

# Admin notifications: Matrix (active per type when homeserver + token + the respective room ID are set)
# The same bot token is used for all rooms; configure room IDs per notification type.
# Room IDs starting with # must be quoted to avoid being treated as comments.
MATRIX_ADMIN_HOMESERVER=https://matrix.example.org
MATRIX_ADMIN_TOKEN=syt_exampletoken_1234567890abcdef
MATRIX_ADMIN_EVENTS_ROOM_ID="!abcdefghij:matrix.example.org"
MATRIX_ADMIN_REPORTS_ROOM_ID="!abcdefghij:matrix.example.org"

# Shall webhooks actually call other servers? Default is off to work privacy-preserving.
WEBHOOKS_ACTIVE=true

# Should the webfinger endpoint be active?
WEBFINGER_ACTIVE=true

# How many minutes before and after the journey should be considered for the "good enough" and "full points" calculation?
GOOD_ENOUGH_POINTS_MIN_BEFORE=60
GOOD_ENOUGH_POINTS_MIN_AFTER=60
FULL_POINTS_MIN_BEFORE=20
FULL_POINTS_MIN_AFTER=10

# Here you can set the default values for the privacy settings
PRIVACY_ACCOUNT_DELETION_SEND_NOTIFICATION=false
PRIVACY_ACCOUNT_DELETION_DELETE_ACCOUNT=false

# For local development, we recommend to always generate the swagger documentation.
# This will make sure that the documentation is always up to date, if you access it via /api/documentation.
# So you don't forget to publish the documentation after changing the API.
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# The following settings are used for the motis API
MOTIS_RADIUS=200
MOTIS_NEARBY_RADIUS=200# Radius in meters for the nearby location search
MOTIS_RESULTS=50# Maximum number of results to be requested
MOTIS_FILTER_LICENSES=false# Filter out all results that are not licensed under an acceptable license

# BRouter snaps route segments onto real tracks. Disabled by default: without a reachable
# instance, segments are built from provider geometry and great-circle arcs only.
BROUTER_ENABLED=false
BROUTER_URL=https://brouter.de/brouter

PROMETHEUS_ALLOWED_IPS=127.0.0.1,::1,10.11.12.1
