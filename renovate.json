{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "gitmoji"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "all non-major dependencies",
            "schedule": ["every 2 weeks on Monday"],
            "automerge": true
        }
    ]
}
